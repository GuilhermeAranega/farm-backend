// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model EnvironmentalData {
  id             String   @id @default(cuid()) @map("_id")
  timestamp      DateTime @unique @default(now())
  soilMoisture   Int      @map("soil_moisture")
  airTemperature Float    @map("air_temperature")
  airHumidity    Float    @map("air_humidity")
  lightIntensity Float    @map("light_intensity")
  deviceId       Int      @map("device_id")

  @@map("environmental_data")
}

model EnergyMetric {
  id             String   @id @default(cuid()) @map("_id")
  timestamp      DateTime @unique @default(now())
  solarPower     Float    @map("solar_power")
  batteryVoltage Float    @map("battery_voltage")
  batteryCharge  Int      @map("battery_charge")
  deviceId       Int      @map("device_id")

  @@map("energy_metrics")
}

model WaterPumpLog {
  id        String   @id @default(cuid()) @map("_id")
  timestamp DateTime @default(now())
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  flowRate  Float    @map("flow_rate")

  @@map("water_pump_log")
}

model Notification {
  id        String    @id @default(cuid()) @map("_id")
  timestamp DateTime  @default(now())
  message   String
  type      NotifType
  isRead    Boolean   @default(false)

  @@map("notifications")
}

enum NotifType {
  ALERT
  WARNING
  INFO
}

enum ReportStatus {
  PENDENTE
  COMPLETO
  ERRO
}

model Report {
  id        String       @id @default(cuid()) @map("_id")
  timestamp DateTime     @default(now())
  status    ReportStatus @default(PENDENTE)
  filePath  String?      @map("file_path")

  @@map("reports")
}

model User {
  id           String         @id @default(cuid()) @map("_id")
  username     String         @unique
  passwordHash String
  sessions     SessionToken[]

  @@map("users")
}

model SessionToken {
  id        String   @id @default(cuid()) @map("_id")
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@map("session_tokens")
}
