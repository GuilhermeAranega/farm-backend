// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model EnvironmentalData {
  id             Int      @id @default(autoincrement())
  timestamp      DateTime @default(now())
  soilMoisture   Int      @map("soil_moisture")
  airTemperature Float    @map("air_temperature")
  airHumidity    Float    @map("air_humidity")
  lightIntensity Float    @map("light_intensity")

  @@map("environmental_data")
}

model EnergyMetric {
  id             Int      @id @default(autoincrement())
  timestamp      DateTime @default(now())
  solarPower     Int      @map("solar_power")
  batteryVoltage Int      @map("battery_voltage")
  batteryCharge  Int      @map("battery_charge")

  @@map("energy_metrics")
}

model WaterPumpLog {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  flowRate  Float    @map("flow_rate")

  @@map("water_pump_log")
}
